# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Core
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=

# Database (example)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Redis (example)
REDIS_URL=redis://localhost:6379/0

# Optional storage / S3
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Other service URLs
EXTERNAL_API_URL=
# Knowledge RAG - Environment Configuration Template
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env to version control - it contains secrets!

# === Application ===
APP_ENV=development
APP_TITLE=Knowledge RAG API
APP_VERSION=2.0.0
LOG_LEVEL=INFO

# === Database ===
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=knowledge_rag
DOCUMENT_COLLECTION=documents
CHUNK_COLLECTION=chunks

# === Storage (choose one: local or appwrite) ===
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=temp_uploads

# Appwrite (optional - leave empty if using local storage)
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_BUCKET_ID=

# === OCR Provider (optional) ===
OCR_PROVIDER=none
AZURE_DOC_INTELLIGENCE_ENDPOINT=
AZURE_DOC_INTELLIGENCE_KEY=
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=

# === Embedding Service ===
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=models/gemini-embedding-2
GEMINI_API_KEY=

# === LLM Service ===
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
LLM_TEMPERATURE=0.2

# === Audio Services ===
# ElevenLabs (for transcription and TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_TRANSCRIPTION_MODEL=scribe_v1
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# OpenAI (optional fallback for audio)
OPENAI_API_KEY=

# === Retrieval ===
DEFAULT_TOP_K=6
MAX_TOP_K=20

# === Chunking ===
CHUNK_MAX_TOKENS=700
CHUNK_MIN_TOKENS=450
CHUNK_OVERLAP_TOKENS=120

# === Network ===
HTTP_TIMEOUT_SECONDS=30
RETRY_ATTEMPTS=3

# === Monitoring ===
PROMETHEUS_ENABLED=false
